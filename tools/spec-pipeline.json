{
  "metric": "cadence",
  "cadenceFrames": 500,
  "rounds": 2,
  "reload": true,
  "configs": [
    {
      "name": "① 基线 unreal+scale1.0",
      "setup": "window.__mpLayers({particles:true,cover:true}); window.__mpSet({bloom:true, bloomStrength:0.6}); window.__mpSet({renderScale:1.0}); 'baseline'"
    },
    {
      "name": "② 关泛光",
      "setup": "window.__mpSet({bloom:false}); 'bloom off'"
    },
    {
      "name": "③ 基线 + scale 0.6",
      "setup": "window.__mpSet({bloom:true, bloomStrength:0.6}); window.__mpSet({renderScale:0.6}); 'bloom on, scale 0.6'"
    },
    {
      "name": "④ 关封面层（泛光开 scale1.0）",
      "setup": "window.__mpSet({renderScale:1.0}); window.__mpLayers({particles:true,cover:false}).then(r=>JSON.stringify(r.actual)+' ok='+r.ok)"
    }
  ]
}
